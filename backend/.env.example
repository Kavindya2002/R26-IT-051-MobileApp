# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.

# ============================================================
# SUPABASE
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# HIVEMQ — Component 2 keeps this original shared broker.
# Components 1 and 3 each use their OWN HiveMQ Cloud cluster
# (see COMPONENT1_HIVEMQ_* / COMPONENT3_HIVEMQ_* below).
# ============================================================
HIVEMQ_BROKER=your-component2-cluster-id.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=your-component2-hivemq-username
HIVEMQ_PASSWORD=your-component2-hivemq-password

# Component 1 — separate HiveMQ Cloud cluster
COMPONENT1_HIVEMQ_BROKER=your-component1-cluster-id.s1.eu.hivemq.cloud
COMPONENT1_HIVEMQ_PORT=8883
COMPONENT1_HIVEMQ_USERNAME=your-component1-hivemq-username
COMPONENT1_HIVEMQ_PASSWORD=your-component1-hivemq-password

# Component 3 — separate HiveMQ Cloud cluster
COMPONENT3_HIVEMQ_BROKER=your-component3-cluster-id.s1.eu.hivemq.cloud
COMPONENT3_HIVEMQ_PORT=8883
COMPONENT3_HIVEMQ_USERNAME=your-component3-hivemq-username
COMPONENT3_HIVEMQ_PASSWORD=your-component3-hivemq-password

# Per-component topics — each is on its OWN broker now, so the
# topic string itself can stay simple (no cross-broker collision risk).
# Point your ESP32 firmware at these exact topic strings.
COMPONENT1_TOPIC=eldercare/component1/imu
COMPONENT2_TOPIC=eldercare/component2/#
COMPONENT3_TOPIC=eldercare/component3/vitals

# Single-elder MVP limitation: the automatic MQTT -> Component 4 flow
# needs an elder_id to write alert history against. Set this once you
# have a real elder row (select id from elders). Leave blank to skip
# history for automatic alerts (manual/escalate calls still work).
DEFAULT_ELDER_ID=

# ============================================================
# CAMERA / YOLO (Component 2) — optional
# ============================================================
# Leave CAMERA_ENABLED=false if you have no ESP32-CAM hardware yet
# or are running on a machine without a GPU — the rest of the
# backend (Components 1/3/4, elders, users) works fine without it.
CAMERA_ENABLED=false
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
YOLO_IMAGE_SIZE=640
# Leave blank for CPU, or set to "0" / "cuda:0" etc. for GPU inference.
YOLO_DEVICE=
CAMERA_RECONNECT_SECONDS=3
CAMERA_TARGET_FPS=10

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
CORS_ALLOW_ORIGINS=*
